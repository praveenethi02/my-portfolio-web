// Prisma schema: describes the database tables.
// After changing this file run: npm run db:migrate -- --name <what-changed>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (fixed lists of allowed values) ----------

enum SkillSource {
  MANUAL // added by hand in /admin
  GITHUB // calculated from GitHub repository languages
}

enum SyncSource {
  GITHUB
  JIRA
  LINKEDIN
}

enum SyncStatus {
  SUCCESS
  FAILED
}

// ---------- Portfolio content ----------

// One GitHub repository shown on the Projects page
model Project {
  id              String    @id @default(cuid())
  githubId        Int?      @unique // GitHub's own id; null for projects added by hand
  name            String
  description     String?
  language        String?
  topics          String[]
  stars           Int       @default(0)
  repoUrl         String
  liveUrl         String?
  featured        Boolean   @default(false) // "pinned" projects are shown first
  hidden          Boolean   @default(false) // hidden projects never appear on the site
  sortOrder       Int       @default(0)
  githubUpdatedAt DateTime? // last push time reported by GitHub
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  category  String // e.g. "Frontend", "Backend", "Tools"
  level     Int         @default(50) // 0-100, drawn as a progress bar
  source    SkillSource @default(MANUAL)
  visible   Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime? // null means "Present"
  description String?
  companyUrl  String?
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime? // null means "Present"
  description  String?
  visible      Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Site data ----------

// Messages sent from the contact form
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// One row per GitHub / Jira / LinkedIn sync run, used to show "last synced" in /admin
model SyncLog {
  id         String     @id @default(cuid())
  source     SyncSource
  status     SyncStatus
  itemCount  Int        @default(0)
  message    String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
}

// Site-wide settings. There is only ever one row, with id = 1.
model Settings {
  id               Int      @id @default(1)
  githubUsername   String?
  githubUrl        String?
  linkedinUrl      String?
  jiraUrl          String?
  showJiraActivity Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}