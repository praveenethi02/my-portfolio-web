# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon pooled connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Neon direct connection string (no "-pooler")
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# GitHub fine-grained personal access token (read-only, public repositories).
# Optional: without it GitHub allows only 60 requests per hour.
GITHUB_TOKEN="github_pat_example"
